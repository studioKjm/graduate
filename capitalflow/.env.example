# Django Backend Configuration
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database Configuration
DB_NAME=capitalflow_dev
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://localhost:6379/1
REDIS_PASSWORD=

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email Configuration (for production)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@capitalflow.com

# Security Settings (for production)
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_SSL_REDIRECT=False

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your-mapbox-token-here

# External API Keys (for data sources)
WORLD_BANK_API_KEY=your-world-bank-api-key
IMF_API_KEY=your-imf-api-key
OECD_API_KEY=your-oecd-api-key

# Monitoring and Logging
SENTRY_DSN=
LOG_LEVEL=INFO